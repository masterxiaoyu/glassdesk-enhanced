<Window
    x:Class="GlassDesk.Dock.DockToolGroupEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑软件聚合"
    Width="420" Height="500" MinWidth="360" MinHeight="360"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="#FF1C1D24" Foreground="#FFF2F2F7">
  <!-- 全局控件使用浅色文字；编辑窗须有不透明深色底，避免白底白字。 -->
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="聚合名称" Margin="0,0,0,6" />
    <TextBox x:Name="GroupNameInput" Grid.Row="1" MaxLength="40"
             AutomationProperties.Name="聚合名称" Margin="0,0,0,16" />

    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="导入软件…" Padding="10,5"
              AutomationProperties.Name="导入软件到应用库"
              Click="OnImportClick" />
      <TextBlock Text="选择要聚合的软件" VerticalAlignment="Center" />
    </DockPanel>

    <Border Grid.Row="3" BorderBrush="#55808080" BorderThickness="1"
            CornerRadius="5" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AppChoices" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" MinWidth="72" Margin="0,0,8,0"
              IsCancel="True" />
      <Button Content="保存" MinWidth="72" IsDefault="True"
              Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
