<controls:GlassWindow
    x:Class="GlassDesk.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    xmlns:settings="clr-namespace:GlassDesk.Settings"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="GlassDesk 设置"
    AutomationProperties.Name="GlassDesk 设置中心"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    Loaded="OnSettingsWindowLoaded"
    Width="760"
    Height="560">

  <controls:GlassWindow.Resources>
    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">12</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">12</sys:Double>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Grip" Width="6" HorizontalAlignment="Center"
                      CornerRadius="3" Background="{TemplateBinding Background}" Opacity="0.5" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
              <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                <Setter TargetName="Grip" Property="Width" Value="Auto" />
                <Setter TargetName="Grip" Property="Height" Value="6" />
                <Setter TargetName="Grip" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="Grip" Property="VerticalAlignment" Value="Center" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="24" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBefore" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimScrollThumb}" Background="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageAfter" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="PageBefore" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="PageAfter" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </controls:GlassWindow.Resources>

  <Border
      Background="{Binding PanelBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
      BorderThickness="0"
      CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
      SnapsToDevicePixels="True">

    <Grid>
    <Grid x:Name="SettingsContentLayer" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="SettingsDragArea" Grid.Row="0"
          Margin="-28,-28,-28,-20" Padding="28,28,28,20"
          Background="Transparent" MouseLeftButtonDown="OnDragArea">
        <TextBlock
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
          Text="GlassDesk 设置" />
      </Border>

      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" AutomationProperties.Name="设置页面">
          <TextBlock
              Margin="0,0,0,8"
              FontSize="12"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
              Text="设置分类" />
          <ListBox x:Name="SettingsPageList" SelectedIndex="1" SelectionChanged="OnSettingsPageSelected"
                   ItemsSource="{Binding PlannedPages, RelativeSource={RelativeSource AncestorType=Window}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock
                    Margin="0,3"
                    FontSize="13"
                    Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <controls:PhoneBorder
            Grid.Column="1"
            Margin="20,0,0,0"
            Padding="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="Transparent">
          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel>
              <TextBlock x:Name="AppearanceSectionHeading" FontSize="16" FontWeight="SemiBold" Text="外观"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,12,0,4" Text="玻璃效果" />
              <ComboBox x:Name="AppearanceMaterialCombo" AutomationProperties.Name="玻璃效果"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="液态玻璃" />
                <ComboBoxItem Content="磨砂玻璃" />
              </ComboBox>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="选择 Dock 与启动台的背景材质。" />
              <TextBlock Margin="0,12,0,4" Text="Dock 透明度" />
              <DockPanel>
                <TextBlock x:Name="DockTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="DockTransparencySlider" Minimum="0" Maximum="1" Value="0.9"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="Dock 透明度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="启动台透明度" />
              <DockPanel>
                <TextBlock x:Name="LauncherTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="LauncherTransparencySlider" Minimum="0" Maximum="1" Value="0.2"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="启动台透明度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,6,0,0" Text="分别调节 Dock 和启动台的玻璃透明度。默认 Dock 90%、启动台 20%。" TextWrapping="Wrap" />
              <TextBlock Margin="0,12,0,4" Text="启动台图标样式" />
              <ComboBox x:Name="LaunchpadIconStyleCombo" AutomationProperties.Name="启动台图标样式"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="实心" />
                <ComboBoxItem Content="空心" />
              </ComboBox>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="设置 Dock 中启动台按钮的图标样式。" />
              <TextBlock Margin="0,12,0,4" Text="Dock 系统图标亮度" />
              <DockPanel>
                <TextBlock x:Name="DockBuiltinIconBrightnessValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="DockBuiltinIconBrightnessSlider" Minimum="0" Maximum="1" Value="1"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="Dock 系统图标亮度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="黑色" /><TextBlock Text="白色" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="调节启动台、此电脑和切换桌面图标三个常驻图标的颜色。" />
              <TextBlock Margin="0,12,0,4" Text="启动台文本亮度" />
              <DockPanel>
                <TextBlock x:Name="LauncherTextBrightnessValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="LauncherTextBrightnessSlider" Minimum="0" Maximum="1" Value="1"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="启动台文本亮度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="黑色" /><TextBlock Text="白色" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="调整应用名称、分组名称和界面文本的亮度。" />
              <CheckBox x:Name="ReduceMotionCheck" Margin="0,10,0,0" Content="减少动画"
                        AutomationProperties.Name="减少动画" Checked="OnAppearanceControlChanged" Unchecked="OnAppearanceControlChanged" />
              <TextBlock x:Name="AppearanceStatus" Margin="0,8,0,12" TextWrapping="Wrap" AutomationProperties.Name="外观设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="DockSectionHeading" FontSize="16" FontWeight="SemiBold" Text="Dock 设置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                         Text="调整 Dock 的缩放比例、长度和显示方式。" />
              <TextBlock Margin="0,12,0,4" Text="显示方式" />
              <ComboBox x:Name="DockDisplayModeCombo" AutomationProperties.Name="Dock 显示方式"
                        SelectionChanged="OnDockControlChanged">
                <ComboBoxItem Content="常驻显示" />
                <ComboBoxItem Content="自动隐藏" />
              </ComboBox>
              <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                         Text="指针悬停时显示，离开后自动隐藏。" />
              <TextBlock Margin="0,12,0,4" Text="左侧固定图标" />
              <CheckBox x:Name="ShowLauncherEntryCheckBox" Content="显示启动台" Margin="0,4"
                        AutomationProperties.Name="Dock 显示启动台" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <CheckBox x:Name="ShowThisPcEntryCheckBox" Content="显示此电脑" Margin="0,4"
                        AutomationProperties.Name="Dock 显示此电脑" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <CheckBox x:Name="ShowDesktopIconsEntryCheckBox" Content="显示切换桌面图标" Margin="0,4"
                        AutomationProperties.Name="Dock 显示切换桌面图标" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="按启动台、此电脑、切换桌面图标的顺序固定在左侧。切换桌面图标用于显示或隐藏桌面上的图标。" />
              <TextBlock Margin="0,12,0,4" Text="窗口管理" />
              <CheckBox x:Name="ShowRunningWindowsCheck" Margin="0,4"
                        Content="显示未固定的运行窗口"
                        AutomationProperties.Name="Dock 显示运行窗口"
                        Checked="OnDockControlChanged"
                        Unchecked="OnDockControlChanged" />
              <TextBlock Text="任务栏模式" Margin="0,8,0,4" />
              <ComboBox x:Name="TaskbarModeCombo"
                        AutomationProperties.Name="任务栏模式"
                        SelectionChanged="OnDockControlChanged">
                <ComboBoxItem Content="Windows 原生任务栏" />
                <ComboBoxItem Content="macOS 风格菜单栏" />
              </ComboBox>
              <TextBlock Margin="0,4,0,10" TextWrapping="Wrap"
                         Text="顶部菜单栏模式下隐藏 Windows 任务栏；切换模式或退出后恢复。" />
              <TextBlock Margin="0,12,0,4" Text="缩放比例" />
              <Slider x:Name="DockScaleSlider" Minimum="0.6666666666666666" Maximum="1.5"
                      SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                      AutomationProperties.Name="Dock 整体大小" ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockScaleReadout" Margin="0,2,0,6" FontSize="11" AutomationProperties.Name="Dock 整体大小当前值" />
              <TextBlock Margin="0,12,0,4" Text="Dock 长度（逻辑像素）" />
              <Slider x:Name="DockFrameLengthSlider" Minimum="180" Maximum="180" TickFrequency="8"
                      AutomationProperties.Name="Dock 外框长度（DIP）"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockFrameLengthReadout" Margin="0,2,0,6" FontSize="11"
                         AutomationProperties.Name="Dock 外框长度当前值" />
              <Button Content="自适应内容宽度" HorizontalAlignment="Left" Margin="0,2,0,4"
                      AutomationProperties.Name="Dock 外框长度自动调整" Click="OnDockAutoLengthClick" />
              <TextBlock Margin="0,12,0,4" Text="位置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <ComboBox x:Name="DockPlacementCombo" AutomationProperties.Name="Dock 位置"
                        SelectionChanged="OnDockControlChanged">
                <ComboBoxItem Content="底部居中" />
                <ComboBoxItem Content="底部左侧" />
                <ComboBoxItem Content="底部右侧" />
                <ComboBoxItem Content="顶部居中" />
              </ComboBox>
              <TextBlock Margin="0,10,0,4" Text="水平偏移"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Slider x:Name="DockOffsetXSlider" AutomationProperties.Name="Dock 水平偏移"
                      Minimum="-200" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock Margin="0,10,0,4" Text="垂直偏移"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Slider x:Name="DockOffsetYSlider" AutomationProperties.Name="Dock 垂直偏移"
                      Minimum="-200" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockSettingsStatus" Margin="0,10,0,16" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="LauncherSectionHeading" FontSize="16" FontWeight="SemiBold" Text="启动台设置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,12,0,4" Text="行数（2–10）" />
              <Slider x:Name="LauncherRowsSlider" Minimum="2" Maximum="10" TickFrequency="1"
                      IsSnapToTickEnabled="True" AutomationProperties.Name="启动台行数"
                      ValueChanged="OnLauncherControlChanged" />
              <TextBlock Margin="0,8,0,4" Text="列数（2–12）" />
              <Slider x:Name="LauncherColumnsSlider" Minimum="2" Maximum="12" TickFrequency="1"
                      IsSnapToTickEnabled="True" AutomationProperties.Name="启动台列数"
                      ValueChanged="OnLauncherControlChanged" />
              <CheckBox x:Name="LauncherFocusSearchCheck" Margin="0,8,0,0" Content="打开时聚焦搜索"
                        AutomationProperties.Name="打开时聚焦搜索"
                        Checked="OnLauncherControlChanged" Unchecked="OnLauncherControlChanged" />
              <CheckBox x:Name="LauncherRememberPageCheck" Margin="0,8,0,0" Content="记住当前浏览页"
                        AutomationProperties.Name="记住启动台页码"
                        Checked="OnLauncherControlChanged" Unchecked="OnLauncherControlChanged" />
              <TextBlock x:Name="LauncherSettingsStatus" Margin="0,10,0,16" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="ShortcutsSectionHeading" FontSize="16" FontWeight="SemiBold" Text="快捷操作"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="WinKeyWindowSwitcherCheck" Margin="0,10,0,6"
                        Content="单击 Win 键打开窗口切换"
                        AutomationProperties.Name="单击 Win 键打开窗口切换"
                        Checked="OnWinKeyWindowSwitcherChanged"
                        Unchecked="OnWinKeyWindowSwitcherChanged" />
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="使用方向键或鼠标选择窗口，按 Esc 关闭。" />
              <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="点击当前快捷键即可录制键盘组合、标点键、鼠标侧键或滚轮方向，录制后自动保存。Esc 取消，Backspace / Delete 清除绑定。" />
              <UniformGrid Columns="2">
                <TextBlock Margin="0,7" Text="打开/关闭启动台" /><settings:ShortcutRecorder x:Name="ToggleLauncherHotkeyBox" AutomationProperties.Name="打开/关闭启动台快捷键"  RecordingCompleted="OnShortcutRecordingCompleted" />
                <TextBlock Margin="0,7" Text="下一页" /><settings:ShortcutRecorder x:Name="NextPageHotkeyBox" AutomationProperties.Name="下一页快捷键"  RecordingCompleted="OnShortcutRecordingCompleted" />
                <TextBlock Margin="0,7" Text="上一页" /><settings:ShortcutRecorder x:Name="PreviousPageHotkeyBox" AutomationProperties.Name="上一页快捷键"  RecordingCompleted="OnShortcutRecordingCompleted" />
                <TextBlock Margin="0,7" Text="切换桌面图标" /><settings:ShortcutRecorder x:Name="ToggleDesktopIconsHotkeyBox" AutomationProperties.Name="切换桌面图标快捷键"  RecordingCompleted="OnShortcutRecordingCompleted" />
                <TextBlock Margin="0,7" Text="锁定 Dock 全屏唤出" /><settings:ShortcutRecorder x:Name="ToggleDockRevealLockHotkeyBox" AutomationProperties.Name="切换 Dock 全屏唤出锁定快捷键"  RecordingCompleted="OnShortcutRecordingCompleted" />
              </UniformGrid>
              <TextBlock x:Name="InteractionSettingsStatus" Margin="0,8,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="快捷操作设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="PerformanceSectionHeading" FontSize="16" FontWeight="SemiBold" Text="性能"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="AutoSuspendWhenFullscreenCheck" Margin="0,10,0,8" Content="全屏应用运行时自动休眠"
                        AutomationProperties.Name="全屏应用运行时自动休眠" IsEnabled="False"
                        Checked="OnPerformanceControlChanged" Unchecked="OnPerformanceControlChanged" />
              <TextBlock TextWrapping="Wrap" Text="游戏和视频全屏时收起 Dock 并暂停背景处理。可用键盘快捷键或托盘临时打开启动台；窗口化游戏可在托盘手动启用游戏休眠。" />
              <TextBlock x:Name="PerformanceSettingsStatus" Margin="0,8,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="性能设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="DesktopSectionHeading" FontSize="16" FontWeight="SemiBold" Text="桌面"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,8,0,10" TextWrapping="Wrap" Text="显示或隐藏 Windows 桌面图标。" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DesktopIconsToggleButton" Padding="10,7" Content="切换桌面图标显示"
                        AutomationProperties.Name="切换桌面图标显示" Click="OnDesktopIconsToggleClick" />
              </StackPanel>
              <TextBlock x:Name="DesktopSettingsStatus" Margin="0,8,0,14" TextWrapping="Wrap" AutomationProperties.Name="桌面图标显示状态" />
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Windows 任务栏"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="TaskbarAutoHideCheck" Margin="0,10,0,4"
                        Content="自动隐藏系统任务栏"
                        AutomationProperties.Name="自动隐藏系统任务栏"
                        Checked="OnTaskbarAutoHideChanged"
                        Unchecked="OnTaskbarAutoHideChanged" />
              <TextBlock x:Name="TaskbarAutoHideStatus" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="系统任务栏自动隐藏状态" />
              <TextBlock x:Name="TaskbarPositionStatus" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="系统任务栏位置状态" />
              <TextBlock x:Name="SystemTransparencyStatus" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Windows 透明效果状态" />
              <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                <Run Text="管理 Windows 任务栏与系统透明效果。" />
                <Run Text="" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Padding="10,7" Content="打开任务栏设置"
                        AutomationProperties.Name="打开 Windows 任务栏设置"
                        Click="OnOpenTaskbarSettingsClick" />
                <Button Margin="8,0,0,0" Padding="10,7" Content="打开透明效果设置"
                        AutomationProperties.Name="打开 Windows 透明效果设置"
                        Click="OnOpenTransparencySettingsClick" />
              </StackPanel>
              <TextBlock x:Name="TaskbarSettingsStatus" Margin="0,0,0,14"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="任务栏设置结果" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="BackupSectionHeading" FontSize="16" FontWeight="SemiBold" Text="备份与恢复"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="BackupInfoText" Margin="0,10,0,14" TextWrapping="Wrap" AutomationProperties.Name="备份与恢复说明"
                         Text="GlassDesk 备份包含本产品的设置、应用库、Dock 与启动台布局及自定义图标。恢复前会先保存当前数据副本。请选择一个文件夹来创建备份，或选择已有备份文件夹进行恢复。" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="CreateBackupButton" Padding="10,7" Content="创建备份"
                        AutomationProperties.Name="创建 GlassDesk 备份" Click="OnCreateBackupClick" />
                <Button x:Name="RestoreBackupButton" Margin="8,0,0,0" Padding="10,7" Content="从备份恢复"
                        AutomationProperties.Name="从 GlassDesk 备份恢复" Click="OnRestoreBackupClick" />
              </StackPanel>
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                         Text="删除用户数据不会卸载程序，也不会更改登录启动项。建议先把备份保存到 GlassDesk 数据目录之外。此操作会删除目录内的设置、应用库、布局、自定义图标、内部备份和日志；外部导入文件原件及目录外备份会保留。" />
              <Button x:Name="DeleteUserDataButton" Width="190" HorizontalAlignment="Left" Padding="10,7"
                      Content="删除全部 GlassDesk 数据" AutomationProperties.Name="删除全部 GlassDesk 用户数据"
                      Click="OnDeleteUserDataClick" />
              <TextBlock x:Name="BackupStatus" Margin="0,0,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="备份与恢复状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="SponsorshipSectionHeading" FontSize="16" FontWeight="SemiBold" Text="赞助支持"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="SponsorshipFreeNotice" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                         AutomationProperties.Name="软件免费与自愿赞助说明"
                         Text="GlassDesk 免费提供全部功能。赞助完全自愿，不赞助也能使用全部功能，无需付费解锁。" />
              <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                          Text="如果本修改版对您有帮助，可以自愿支持本修改版维护者；收款方与原作者无关。" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="SponsorAlipayOption" Content="支付宝" GroupName="SponsorPaymentMethod"
                             Padding="6,4" Margin="0,0,20,0" IsChecked="True"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                             AutomationProperties.Name="使用支付宝赞助" VerticalAlignment="Center" />
                <RadioButton x:Name="SponsorWechatOption" Content="微信支付" GroupName="SponsorPaymentMethod"
                             Padding="6,4" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                             AutomationProperties.Name="使用微信支付赞助" VerticalAlignment="Center" />
                <Button x:Name="SponsorButton" Content="赞助" Width="88" Height="32" Margin="20,0,0,0"
                        AutomationProperties.Name="打开所选方式的赞助收款码" Click="OnSponsorClick" />
              </StackPanel>
              <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         Text="选择支付方式后点击“赞助”查看收款码，扫码后可在手机端自定义金额。" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="AboutSectionHeading" FontSize="16" FontWeight="SemiBold" Text="关于"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                         Text="本软件是基于 GlassDesk 1.4.0 的非官方修改版。原作者：everlosttime。" />
              <TextBlock Margin="0,0,0,4" TextWrapping="Wrap"
                         Text="原产品：https://github.com/everlosttime/glassdesk" />
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                         Text="公开源码：https://github.com/everlosttime/glassdesk-open-source" />
              <TextBlock x:Name="ProductVersionText" Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold"
                         AutomationProperties.Name="GlassDesk 当前版本" />
              <Button x:Name="CheckUpdateButton" Width="132" HorizontalAlignment="Left" Padding="10,7"
                      Content="检查更新" AutomationProperties.Name="检查 GlassDesk 更新" Click="OnCheckUpdateClick" />
              <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,12" TextWrapping="Wrap"
                         AutomationProperties.Name="GlassDesk 更新状态" Text="启动时会自动检查新版本，也可以手动检查。" />
              <CheckBox
                  x:Name="AutostartCheck"
                  Margin="0,12,0,0"
                  Content="登录时启动 GlassDesk（仅当前用户）"
                  AutomationProperties.Name="登录时启动 GlassDesk，仅当前用户"
                  IsEnabled="False"
                  Click="OnAutostartClick" />
              <TextBlock
                  x:Name="AutostartStatus"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                  AutomationProperties.Name="登录启动注册状态" />
              <TextBlock
                  x:Name="AutostartExecutableText"
                  Margin="0,2,0,12"
                  TextWrapping="Wrap"
                  AutomationProperties.Name="当前 GlassDesk 可执行文件路径" />
              <Button x:Name="UninstallButton" Width="132" HorizontalAlignment="Left" Padding="10,7"
                      Content="卸载 GlassDesk" AutomationProperties.Name="卸载 GlassDesk 程序"
                      IsEnabled="False" Click="OnUninstallClick" />
              <TextBlock x:Name="InstallationStatus" Margin="0,6,0,12" TextWrapping="Wrap"
                         AutomationProperties.Name="GlassDesk 安装与卸载状态" />
              <TextBlock
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                  Text="运行环境与数据位置" />
              <TextBlock
                  x:Name="DiagnosticsText"
                  Margin="0,10,0,0"
                  FontSize="12"
                  TextWrapping="Wrap"
                  LineHeight="20"
                  Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </ScrollViewer>
        </controls:PhoneBorder>
      </Grid>

      <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ResetPageButton" Width="144" Height="32" Margin="0,0,8,0"
            Content="恢复当前页默认" AutomationProperties.Name="恢复当前页默认" Click="OnResetPageClick" />
        <Button
            Width="96"
            Height="32"
            Content="关闭"
            AutomationProperties.Name="关闭设置"
            Click="OnCloseClick" />
      </StackPanel>
    </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>
